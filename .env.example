# ===== KiotViet Public API =====
# Lay tu trang quan tri KiotViet > Thiet lap > API
KIOTVIET_CLIENT_ID=
KIOTVIET_CLIENT_SECRET=
KIOTVIET_RETAILER=
KIOTVIET_TOKEN_URL=https://id.kiotviet.vn/connect/token
KIOTVIET_API_BASE_URL=https://public.kiotviet.vn

# ===== Anthropic Claude API =====
ANTHROPIC_API_KEY=

# ===== SMTP / Nodemailer =====
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
REPORT_EMAIL_FROM="He thong Bao cao KiotViet <no-reply@example.com>"
REPORT_EMAIL_TO=giamdoc@example.com,ketoan@example.com

# Gio gui bao cao hang ngay (gio Viet Nam). Chi dung de bootstrap lan dau
# khi chua co config trong DB - sau do doi truc tiep trong man hinh Settings.
REPORT_SEND_HOUR=23
REPORT_SEND_MINUTE=0

# ===== MySQL (Prisma) =====
# Prisma chi doc DATABASE_URL - day la nguon su that duy nhat cho ket noi DB.
# Format: mysql://<user>:<password>@<host>:<port>/<database>
# Neu user/password co ky tu dac biet (@ : / # ...), phai URL-encode.
DATABASE_URL="mysql://root:@localhost:3306/kiotviet_reports"

# ===== Dang nhap / Phan quyen =====
# Bi mat ky JWT - BAT BUOC doi gia tri khac khi len production.
JWT_SECRET=change-this-secret-in-production
# 2 tai khoan duoc TU DONG TAO khi DB chua co user nao (lan chay dau tien sau
# khi build/deploy). Sau khi dang nhap, vao Cai dat he thong > Nguoi dung de
# doi mat khau / xoa tao lai - KHONG dung mat khau mac dinh o production.
ADMIN_EMAIL=admin@ai-office.sys
ADMIN_PASSWORD=admin123
MANAGER_EMAIL=manager@ai-office.sys
MANAGER_PASSWORD=manager123
